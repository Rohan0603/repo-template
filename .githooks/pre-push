#!/usr/bin/env sh
# Fail closed: scan Git commits before they leave this machine.
# Install once per clone: git config --local core.hooksPath .githooks
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Secret scan BLOCKED: install Gitleaks (https://github.com/gitleaks/gitleaks) before pushing." >&2
  exit 1
fi

remote_name="${1:-origin}"

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "$local_ref" ] || continue

  # A ref deletion does not introduce new commits.
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac

  case "$remote_oid" in
    *[!0]*)
      if ! git cat-file -e "${remote_oid}^{commit}" 2>/dev/null; then
        echo "Secret scan BLOCKED: cannot inspect remote base $remote_ref. Fetch $remote_name before retrying." >&2
        exit 1
      fi
      range="${remote_oid}..${local_oid}"
      pending="$(git rev-list --max-count=1 "$range")"
      ;;
    *)
      # A newly pushed ref may contain commits beyond those on remote-tracking branches.
      range="$local_oid --not --remotes=$remote_name"
      pending="$(git rev-list --max-count=1 "$local_oid" --not "--remotes=$remote_name")"
      ;;
  esac

  [ -n "$pending" ] || continue
  echo "Scanning commits for $local_ref -> $remote_ref with Gitleaks..." >&2
  # Redaction prevents matching secrets being echoed in ordinary scanner output.
  if ! gitleaks git --redact --no-banner --log-opts="$range" .; then
    echo "Secret scan BLOCKED: remove secrets from every affected commit before pushing." >&2
    exit 1
  fi
done
